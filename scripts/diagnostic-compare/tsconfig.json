{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true,
    "outDir": "../../.ts-out"
  },
  "include": ["./**/*.ts"],
  "exclude": ["../../node_modules"]
}
