    "@types/nodemailer": "^6.4.17",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@upstash/redis": "^1.36.1",
    "autoprefixer": "10.4.23",
    "lucide-react": "^0.563.0",
    "next": "^14.2.28",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.12",
    "postcss": "8.5.6",
